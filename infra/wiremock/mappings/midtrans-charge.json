{
  "request": {
    "method": "POST",
    "url": "/v2/charge"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "externalReference": "VA-BCA-{{randomValue length=8 type='NUMERIC'}}",
      "status": "PENDING",
      "expiryTime": "{{now offset='15 minutes' format=\"yyyy-MM-dd'T'HH:mm:ss'Z'\"}}"
    },
    "transformers": ["response-template"]
  }
}